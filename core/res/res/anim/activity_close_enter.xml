<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <alpha
        android:fromAlpha="0.92"
        android:toAlpha="1.0"
        android:fillEnabled="true"
        android:fillBefore="true"
        android:fillAfter="true"
        android:interpolator="@interpolator/linear_out_slow_in"
        android:startOffset="0"
        android:duration="150" />

    <scale
        android:fromXScale="0.992"
        android:toXScale="1.0"
        android:fromYScale="0.992"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:fillEnabled="true"
        android:fillBefore="true"
        android:fillAfter="true"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:duration="360" />

    <translate
        android:fromXDelta="-12dp"
        android:toXDelta="0"
        android:fillEnabled="true"
        android:fillBefore="true"
        android:fillAfter="true"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:startOffset="0"
        android:duration="360" />

    <extend
        android:fromExtendLeft="0"
        android:fromExtendTop="0"
        android:fromExtendRight="12dp"
        android:fromExtendBottom="0"
        android:toExtendLeft="0"
        android:toExtendTop="0"
        android:toExtendRight="12dp"
        android:toExtendBottom="0"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:startOffset="0"
        android:duration="360" />
</set>
